# ============================================================
# LLM Provider: "google" (default) or "openai"
# ============================================================
LLM_PROVIDER=google

# ---- Google Gemini (LLM_PROVIDER=google) --------------------
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---- OpenAI (LLM_PROVIDER=openai) ---------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=   # optional: for Azure / self-hosted endpoints

# ============================================================
# Langfuse (self-hosted via docker-compose)
# ============================================================
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key

# ============================================================
# Logging
# ============================================================
# Global log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Log file path (leave empty to disable file logging)
LOG_FILE=logs/aiops.log

# ============================================================
# Neo4j (used by SCIP agent — docker compose up -d neo4j)
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ============================================================
# SCIP indexer Docker images (optional — defaults shown)
# ============================================================
# SCIP_PYTHON_IMAGE=sourcegraph/scip-python:latest
# SCIP_TYPESCRIPT_IMAGE=sourcegraph/scip-typescript:latest
# SCIP_JAVA_IMAGE=sourcegraph/scip-java:latest
# Platform for docker run (linux/amd64 enables Rosetta on Apple Silicon)
SCIP_DOCKER_PLATFORM=linux/amd64

# ============================================================
# Debug: specify agent name to enable verbose debug mode
# e.g., DEBUG_AGENT=github
# ============================================================
DEBUG_AGENT=
