# ============================================================
# LLM - Google Gemini
# ============================================================
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# Langfuse (self-hosted via docker-compose)
# ============================================================
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key

# ============================================================
# Logging
# ============================================================
# Global log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Log file path (leave empty to disable file logging)
LOG_FILE=logs/aiops.log

# ============================================================
# Debug: specify agent name to enable verbose debug mode
# e.g., DEBUG_AGENT=github
# ============================================================
DEBUG_AGENT=
